# HTTP
HOST=0.0.0.0
PORT=8787
NAVEBOX_PUBLIC_ORIGIN=http://localhost:8787
NAVEBOX_API_TOKEN=change-me-with-at-least-24-characters
NAVEBOX_ALLOWED_ORIGINS=http://localhost:5173

# Runtime: docker em produção; process é permitido apenas para desenvolvimento/testes.
NAVEBOX_SANDBOX=docker
NAVEBOX_DATA_DIR=./data
NAVEBOX_MAX_WORKSPACES=20
NAVEBOX_WORKSPACE_TTL_MS=3600000
NAVEBOX_MEMORY_MB=768
NAVEBOX_CPU_LIMIT=1
NAVEBOX_PREVIEW_DOMAIN=

# Artifact storage: local | supabase
NAVEBOX_STORAGE=local
NAVEBOX_LOCAL_ARTIFACTS=./data/artifacts
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=navebox-deployments
SUPABASE_PUBLIC_BUCKET=true

# Deployment targets. Secrets stay on the runner and are selected by id.
# NAVEBOX_SSH_TARGETS={"production":{"host":"server.example","user":"deploy","port":22,"baseDir":"/opt/navebox","publicBaseUrl":"https://apps.example"}}
NAVEBOX_SSH_TARGETS={}
# NAVEBOX_KUBERNETES_TARGETS={"production":{"namespace":"navebox","registry":"ghcr.io/org/apps","ingressDomain":"apps.example"}}
NAVEBOX_KUBERNETES_TARGETS={}
